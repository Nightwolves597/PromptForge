# Copy this file to ".env" (same folder) and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional settings
GEMINI_MODEL=gemini-3.8-flash
TOKENIZER_ENCODING=o200k_base
PORT=8000
# Leave empty to use Gemini's default. Only set it if you know you want to.
GEMINI_TEMPERATURE=

# Optional backup AIs. Used only when every Gemini model fails, in this order.
# Fill in any of them. Leave the rest empty.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Optional: pick a different model for a backup, for example
# GROQ_MODEL=llama-3.3-70b-versatile
